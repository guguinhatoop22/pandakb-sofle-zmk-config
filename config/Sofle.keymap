#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define SYMBOLS_BASE 1
#define RUCHEY 2
#define SYMBOLS_RUCHEY 3
#define EDITING 4
#define ADJUST 5

/ {

   // Activate ADJUST layer by pressing raise and lower
    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_layer {
            if-layers = <SYMBOLS_BASE EDITING>;
            then-layer = <ADJUST>;
        };
        adjust_layer_legacy {
            if-layers = <SYMBOLS_RUCHEY EDITING>;
            then-layer = <ADJUST>;
        };
    };

    behaviors {
        rgb_encoder: rgb_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_EFF>, <&rgb_ug RGB_EFR>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&kp ESC   &kp N1 &kp N2   &kp N3   &kp N4    &kp N5                                       &kp N6      &kp N7    &kp N8    &kp N9   &kp N0   &kp NUBS
&kp TAB   &kp Q  &kp W    &kp E    &kp R     &kp T                                        &kp Y       &kp U     &kp I     &kp O    &kp P    &kp LBKT
&kp GRAVE &kp A  &kp S    &kp D    &kp F     &kp G                                        &kp H       &kp J     &kp K     &kp L    &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X    &kp C    &kp V     &kp B            &kp C_MUTE  &rgb_ug RGB_TOG &kp N       &kp M     &kp COMMA &kp DOT  &kp FSLH &mt RSHFT RET
                 &kp LGUI &kp LALT &kp LCTRL &mo SYMBOLS_BASE &kp SPACE   &kp BSPC        &mo EDITING &kp RCTRL &kp RALT  &kp RGUI
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &rgb_encoder>;
        };

        symbols_base_layer {
            display-name = "Symbols";
            bindings = <
&trans    &trans    &trans    &trans   &trans   &trans                   &trans    &trans   &trans    &trans    &trans   &trans
&trans    &kp N1    &kp N2    &kp N3   &kp N4   &kp N5                   &kp N6    &kp N7   &kp N8    &kp N9    &kp N0   &trans
&kp GRAVE &kp EXCL  &kp AT    &kp HASH &kp DLLR &kp PRCNT                &kp CARET &kp AMPS &kp ASTRK &kp LPAR  &kp RPAR &kp PIPE2
&trans    &kp EQUAL &kp MINUS &kp PLUS &kp LBRC &kp RBRC  &trans  &trans &kp LBKT  &kp RBKT &kp SEMI  &kp COLON &kp BSLH &trans
                    &trans    &trans   &trans   &trans    &trans  &trans &trans    &trans   &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &rgb_encoder>;
        };

        ruchey_layer {
            display-name = "Ruchey";
            bindings = <
&kp ESC   &kp N1 &kp N2   &kp N3   &kp N4    &kp N5                                         &kp N6      &kp N7    &kp N8    &kp N9   &kp N0   &kp NUBS
&kp TAB   &kp Q  &kp W    &kp E    &kp R     &kp T                                          &kp Y       &kp U     &kp I     &kp O    &kp P    &kp LBKT
&kp GRAVE &kp A  &kp S    &kp D    &kp F     &kp G                                          &kp H       &kp J     &kp K     &kp L    &kp SEMI &kp SQT
&kp LCTRL &kp Z  &kp X    &kp C    &kp V     &kp B              &kp C_MUTE  &rgb_ug RGB_TOG &kp N       &kp M     &kp COMMA &kp DOT  &kp FSLH &mt RCTRL RET
                 &kp LGUI &kp LALT &kp LSHFT &mo SYMBOLS_RUCHEY &kp SPACE   &kp BSPC        &mo EDITING &kp RSHFT &kp RALT  &kp RGUI
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &rgb_encoder>;
        };

        symbols_ruchey_layer {
            display-name = "Symbols*";
            bindings = <
&kp RA(N8)    &trans     &trans     &trans        &trans       &trans                      &trans        &trans      &trans     &trans     &trans     &kp RBKT
&kp RA(N2)    &kp N1     &kp N2     &kp N3        &kp N4       &kp N5                      &kp N6        &kp N7      &kp N8     &kp N9     &kp N0     &kp RA(N6)
&kp RA(GRAVE) &kp RA(N5) &kp LS(N2) &kp RA(N3)    &kp RA(N4)   &kp LS(N5)                  &kp RA(COMMA) &kp RA(DOT) &kp LS(N8) &kp LS(N9) &kp LS(N0) &kp RA(N7)
&trans        &kp EQUAL  &kp MINUS  &kp LS(EQUAL) &kp RA(LBKT) &kp RA(RBKT) &trans  &trans &kp RA(SEMI)  &kp RA(SQT) &kp LS(N4) &kp LS(N6) &kp LS(N7) &kp LS(N1)
                         &trans     &trans        &trans       &trans       &trans  &trans &trans        &trans      &trans     &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &rgb_encoder>;
        };

        editing_layer {
            display-name = "Editing";
            bindings = <
&trans &kp F1    &kp F2    &kp F3      &kp F4      &kp F5                  &kp F6    &kp F7     &kp F8   &kp F9     &kp F10 &kp F11
&trans &kp INS   &kp PSCRN &kp K_CMENU &trans      &trans                  &kp PG_UP &kp BSPC   &kp UP   &kp DEL    &trans  &kp F12
&trans &kp LGUI  &kp LALT  &kp LCTRL   &kp LSHFT   &kp CLCK                &kp PG_DN &kp LEFT   &kp DOWN &kp RIGHT  &trans  &trans
&trans &kp LC(Z) &kp K_CUT &kp K_COPY  &kp K_PASTE &trans   &trans  &trans &trans    &trans     &trans   &trans     &trans  &kp LA(RET)
                 &trans    &trans      &trans      &trans   &trans  &trans &trans    &kp C_PREV &kp C_PP &kp C_NEXT 
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &rgb_encoder>;
        };

        adjust_layer {
            display-name = "Adjust";
            bindings = <
&bt BT_CLR        &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                   &to RUCHEY &to BASE &none &none &none &none
&ext_power EP_TOG &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_EFF                &none      &none    &none &none &none &none
&none             &rgb_ug RGB_BRD &rgb_ug RGB_BRI &none           &none           &none                          &none      &none    &none &none &none &none
&none             &none           &none           &none           &none           &none            &none  &none  &none      &none    &none &none &none &none
                                  &none           &none           &none           &none            &none  &none  &none      &none    &none &none
            >;
        };

        extra3 {
            status = "reserved";
        };

        extra4 {
            status = "reserved";
        };
    };
};
